## Example environment variables for the contact server
# If you have SMTP credentials, set them to enable real emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=contact@votredomaine.com
CONTACT_RECEIVER=owner@votredomaine.com
